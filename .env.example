# ==========================================
# Douyin Group RPA & Antigravity Bridge 配置
# ==========================================

# 1. 目标抖音群聊与触发关键词配置（请修改为你自己的群名与群昵称）
TARGET_GROUP=你的抖音群聊名称
# 多个 @ 触发别名用英文逗号分隔，不区分大小写（例如：机器人昵称,账号名,Gemini）
BOT_MENTION_ALIASES=吉米妮,gemini

# 2. 抖音网页端与浏览器配置
DOUYIN_URL=https://www.douyin.com/jingxuan
USER_DATA_DIR=browser_profile
HEADLESS=false

# 3. 独立模式大模型配置（若仅使用 --bridge 本尊桥接模式，以下可留空）
# 支持任意 OpenAI 兼容接口，如 DeepSeek / OpenAI / 硅基流动 / Gemini OpenAI 兼容端点等
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 4. 人设与对话参数
PERSONA_FILE=personas/persona-Gemini.md
MAX_HISTORY_TURNS=8

# 5. 可选：Clash Verge / Mihomo 规则模式切换辅助（switch_rule.py）
# MIHOMO_PIPE=\\.\pipe\verge-mihomo-production-xxxxxxxx
# MIHOMO_API_URL=http://127.0.0.1:9097
# MIHOMO_SECRET=set-your-secret
